{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "sandbox": {
    "excludedCommands": [
      "bench",
      "bench *",
      "gh",
      "gh *",
      "git fetch *",
      "git pull *",
      "git -C * fetch *",
      "git -C * pull *"
    ],
    "filesystem": {
      "allowRead": [
        "~/.bench",
        "~/.local/lib"
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$FRAPPE_DEVCONTAINER_DIR/claude-bash-guard.sh\""
          }
        ]
      }
    ]
  }
}
