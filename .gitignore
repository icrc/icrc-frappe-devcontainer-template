# Generated secrets. init-env.sh writes all three; none is ever committed.
.env
.devcontainer/.env
.devcontainer/seaweedfs-s3.json
.devcontainer/keycloak-realm.json

# Host files init-env.sh copies in on every start. The gitconfig and npmrc ones
# can hold a credential.
.devcontainer/.gitconfig.host
.devcontainer/.allowed_signers.host
.devcontainer/.npmrc.host

# The bench itself is generated by install-bench.sh: every app under it is its
# own checkout with its own remote. Only the scripts and the app list here are
# tracked.
development/*
!development/*.sh
!development/*.json
# git subcommand wrappers: git demands the exact `git-<name>`, so these carry
# no extension and the rule above would drop them.
!development/git-*
# The AGENTS.md written into the bench and into a new app.
!development/templates/

# A personal app list, read by get-apps.sh alongside apps.json.
development/apps.local.json

# Frappe
sites

# Editors
.idea
.vscode/**
!.vscode/extensions.json
*.code-workspace

# Python
*.pyc
__pycache__
venv

# Node
node_modules

# Agent and assistant scratch
.claude/
.claude_history/
.aider*
.cursor/
